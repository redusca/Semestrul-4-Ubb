<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ro.mpp2024.controllers.MainController"
            prefHeight="400.0" prefWidth="600.0">

    <HBox spacing="20.0" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0">
        <VBox spacing="10.0">
            <Label fx:id="usernameLabel" text="Username" />
            <Label text="Select Participant:" />
            <ComboBox fx:id="participantComboBox" prefWidth="300" />
            <Label text="Enter Points:" />
            <TextField fx:id="pointsTextField" />
            <Button text="Add Rezultat"  onAction="#addRezultat" />
        </VBox>

        <VBox spacing="20.0">
            <Label text="Participanti" />
            <TableView fx:id="tableView1" prefWidth="500">
                <columns>
                    <TableColumn text="Participant" fx:id="participantColumn1" />
                    <TableColumn text="Numar Puncte" fx:id="pointsColumn1" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <Label text="Participanti Proba" />
            <TableView fx:id="tableView2" prefWidth="500">
                <columns>
                    <TableColumn text="Participant" fx:id="participantColumn2" />
                    <TableColumn text="Numar Puncte" fx:id="pointsColumn2" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <Button text="Logout"  fx:id="logoutButton" onAction="#logout" />
        </VBox>
    </HBox>
</AnchorPane>