<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="port" value="55556"/>
		<add key="ip" value="127.0.0.1"/>
		<add key="log4net.Internal.Debug" value="true"/>
	</appSettings>
  <startup>
    <supportedRuntime version="v9.0" sku=".NETFramework,Version=v9.0" />
  </startup>
  <connectionStrings>
    <add name="triatlon.db" connectionString="Data source={AppDir}triatlon.db" />
  </connectionStrings>
</configuration>
