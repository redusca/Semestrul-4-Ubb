<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ro.mpp2024.controllers.LoginController"
            prefHeight="200.0" prefWidth="250.0">

    <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
        <Label text="Username:" />
        <TextField fx:id="usernameField" prefWidth="150"/>
        <Label text="Password:" />
        <PasswordField fx:id="passwordField" />
        <Button text="Login" fx:id="loginButton" onAction="#login" prefWidth="150"/>
    </VBox>

</AnchorPane>
